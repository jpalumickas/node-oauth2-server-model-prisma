{
  "name": "oauth2-server-model-prisma",
  "version": "0.9.0",
  "description": "Prisma model for oauth2-server",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "prisma/models.prisma"
  ],
  "repository": "https://github.com/jpalumickas/node-oauth2-server-model-prisma",
  "author": {
    "name": "Justas Palumickas",
    "email": "jpalumickas@gmail.com",
    "url": "https://jpalumickas.com"
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0"
  },
  "peerDependencies": {
    "@prisma/client": ">=7",
    "oauth2-server": "3.x"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/bcrypt": "^6.0.0",
    "@types/oauth2-server": "^3.0.18",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.49.0",
    "prisma": "^7.8.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "oauth",
    "oauth2",
    "oauth2-server",
    "grant-type",
    "prisma",
    "model"
  ],
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
